<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!--
        공용 팝업 한 벌. 화면마다 따로 만들지 않고 이것을 복제해 쓴다.
        제목·본문·단추 둘로 이루어지며, 단추 하나만 쓸 때는 왼쪽을 숨긴다.
    -->
    <ui:VisualElement name="popup-veil" class="popup-veil">
        <ui:VisualElement name="popup" class="popup">
            <ui:Label name="popup-tag" text="" class="popup-tag" />
            <ui:Label name="popup-title" text="" class="popup-title" />
            <ui:Label name="popup-body" text="" class="popup-body" />
            <ui:VisualElement class="row" style="margin-top: 20px;">
                <ui:VisualElement class="grow" />
                <ui:Button name="popup-cancel" text="취소" class="cta popup-button" />
                <ui:Button name="popup-confirm" text="확인" class="cta popup-button popup-button--main" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
