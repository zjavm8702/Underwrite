/*
 * 지하거래소 거래 화면 스타일.
 * 토큰 값은 Outputs/MarketUI_v1/Modern_v1/README.md의 설계 규격을 그대로 옮긴 것이다.
 * 수치를 여기서 바꾸면 시안과 어긋나므로, 바꿀 때는 그 문서도 함께 갱신한다.
 */

:root {
    /* ── 색 ───────────────────────────────── */
    --color-canvas: #F5F6F8;
    --color-panel: #FFFFFF;
    --color-text: #202632;
    --color-text-weak: #626C7A;
    --color-divider: #E3E7ED;
    --color-input-border: #7A8493;

    --color-rise: #C53643;
    --color-rise-soft: #FFF0F1;
    --color-fall: #245EC7;
    --color-fall-soft: #EDF3FF;

    --color-private: #6741B0;
    --color-private-soft: #F3EDFF;

    --color-halt: #80510D;
    --color-halt-soft: #FFF4DE;

    --color-disabled: #E3E7ED;

    /* ── 여백 (4px 배수) ──────────────────── */
    --gap-xs: 4px;
    --gap-sm: 8px;
    --gap-md: 12px;
    --gap-lg: 16px;
    --gap-xl: 24px;
    --gap-2xl: 32px;
    --gap-3xl: 48px;
}

/* ── 바탕 ─────────────────────────────────── */

.market-root {
    flex-grow: 1;
    background-color: var(--color-canvas);
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 24px;
    padding-bottom: 64px;
    color: var(--color-text);
}

.panel {
    background-color: var(--color-panel);
    border-radius: 16px;
    padding: 24px;
}

.row {
    flex-direction: row;
}

.grow {
    flex-grow: 1;
}

/* ── 글자 단계 ────────────────────────────── */

.t-title {
    font-size: 28px;
    -unity-font-style: bold;
}

.t-price {
    font-size: 48px;
    -unity-font-style: bold;
}

.t-asset {
    font-size: 30px;
    -unity-font-style: bold;
}

.t-panel {
    font-size: 25px;
    -unity-font-style: bold;
}

.t-body {
    font-size: 20px;
}

.t-body-strong {
    font-size: 20px;
    -unity-font-style: bold;
}

.t-note {
    font-size: 17px;
    color: var(--color-text-weak);
}

.weak {
    color: var(--color-text-weak);
}

/* ── 상단 ─────────────────────────────────── */

.header {
    flex-direction: row;
    align-items: center;
    height: 88px;
}

/* 브랜드 블록이 줄어들면 오른쪽 상태줄과 겹친다. 줄어들지 않게 고정한다.
   Unity USS는 :nth-child를 지원하지 않으므로 클래스로 지정한다. */
.brand {
    flex-shrink: 0;
}

.brand-mark {
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--color-text-weak);
}

.header-status {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: flex-end;
    flex-wrap: wrap;
}

.status-chip {
    font-size: 18px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 8px;
    margin-left: 8px;
}

.status-chip--halt {
    background-color: var(--color-halt-soft);
    color: var(--color-halt);
    -unity-font-style: bold;
}

/* ── 버튼 ─────────────────────────────────── */

.btn {
    height: 56px;
    min-width: 72px;
    border-radius: 12px;
    font-size: 20px;
    border-width: 0;
    background-color: var(--color-disabled);
    color: var(--color-text);
    margin-left: 8px;
    padding-left: 16px;
    padding-right: 16px;
}

.btn:hover {
    opacity: 0.85;
}

.btn--small {
    height: 44px;
    min-width: 48px;
    font-size: 16px;
    padding-left: 10px;
    padding-right: 10px;
    margin-left: 6px;
    flex-shrink: 1;
}

.btn.btn--selected {
    background-color: var(--color-text);
    color: var(--color-panel);
    -unity-font-style: bold;
}

.btn--buy {
    background-color: var(--color-rise);
    color: var(--color-panel);
    -unity-font-style: bold;
}

.btn--sell {
    background-color: var(--color-fall);
    color: var(--color-panel);
    -unity-font-style: bold;
}

.btn--disabled {
    background-color: var(--color-disabled);
    color: var(--color-text-weak);
}

.tab {
    flex-grow: 1;
    height: 56px;
    border-radius: 12px;
    font-size: 20px;
    border-width: 0;
    background-color: var(--color-canvas);
    color: var(--color-text-weak);
    margin-right: 8px;
}

.tab--buy-on {
    background-color: var(--color-rise-soft);
    color: var(--color-rise);
    -unity-font-style: bold;
}

.tab--sell-on {
    background-color: var(--color-fall-soft);
    color: var(--color-fall);
    -unity-font-style: bold;
}

/* ── 자산 줄 ──────────────────────────────── */

.asset-row {
    flex-direction: row;
    margin-top: 16px;
}

.asset-card {
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--color-panel);
    border-radius: 16px;
    padding: 16px 24px 16px 24px;
    margin-right: 24px;
}

.asset-card--last {
    margin-right: 0;
}

/* ── 본문 3열 ─────────────────────────────── */

.body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 24px;
}

/* 고정폭을 쓰지 않는다. Game 뷰 크기와 PanelSettings의 ScaleWithScreenSize 때문에
   논리 폭이 1920이 아닐 수 있다. 실제로 872x1160 창에서는 1142px로 해석된다.
   기준 폭을 flex-basis로 주고 최소폭까지 줄어들게 해 좁은 화면에서도 3열을 유지한다. */
.col-stocks {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: 500px;
    min-width: 300px;
    margin-right: 24px;
}

.col-center {
    padding-bottom: 72px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 320px;
    margin-right: 24px;
}

.col-order {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: 420px;
    min-width: 300px;
}

/* ── 종목 행 ──────────────────────────────── */

.stock-row {
    height: 120px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-divider);
    justify-content: center;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 12px;
}

.stock-row--selected {
    background-color: var(--color-canvas);
}

.stock-line {
    flex-direction: row;
    align-items: center;
}

.stock-name {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    font-size: 20px;
    -unity-font-style: bold;
}

.stock-price {
    font-size: 20px;
    -unity-font-style: bold;
    min-width: 80px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.stock-change {
    font-size: 20px;
    -unity-font-style: bold;
    min-width: 110px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.rise {
    color: var(--color-rise);
}

.fall {
    color: var(--color-fall);
}

.flat {
    color: var(--color-text-weak);
}

/* ── 차트 ─────────────────────────────────── */

.chart {
    flex-grow: 1;
    min-height: 200px;
    margin-top: 28px;
    margin-bottom: 20px;
}

/* 저·시작·고를 차트 위 제자리에 찍는다. 아래에 나란히 적으면 어느 지점인지 알 수 없다.
   위치가 매 틱 바뀌므로 절대 배치로 좌표를 코드에서 준다. */
.chart-marker-label {
    position: absolute;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.78);
    border-radius: 6px;
    padding: 0 6px 0 6px;
}

.chart-marker-label--high {
    color: var(--color-rise);
}

.chart-marker-label--low {
    color: var(--color-fall);
}

.chart-marker-label--open {
    color: var(--color-text-weak);
}

/* ── 정보 카드 ────────────────────────────── */

.info-card {
    min-height: 96px;
    flex-shrink: 0;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 12px;
    background-color: var(--color-canvas);
}

.info-card--private {
    background-color: var(--color-private-soft);
    border-left-width: 4px;
    border-left-color: var(--color-private);
}

.info-tag {
    font-size: 18px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.info-head {
    flex-direction: column;
}

.info-meta {
    font-size: 16px;
    color: var(--color-text-weak);
    margin-top: 2px;
    white-space: normal;
}

.info-tag--private {
    color: var(--color-private);
}

.info-tag--public {
    color: var(--color-text-weak);
}

.info-headline {
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
    margin-top: 8px;
}

/* ── 주문 ─────────────────────────────────── */

.order-line {
    flex-direction: row;
    align-items: center;
    height: 32px;
    flex-shrink: 0;
    margin-bottom: 2px;
}

/* 주문 패널은 위에서 아래로 쌓인다. 어느 요소도 겹치지 않게 모두 줄어들지 않게 둔다. */
.col-order > * {
    flex-shrink: 0;
}

.order-label {
    flex-grow: 1;
    font-size: 20px;
    color: var(--color-text-weak);
}

.order-value {
    font-size: 20px;
    -unity-font-style: bold;
}

.qty-box {
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: var(--color-input-border);
    border-radius: 12px;
    height: 46px;
    flex-shrink: 0;
}

.qty-step {
    width: 44px;
    height: 46px;
    font-size: 24px;
    background-color: transparent;
    border-width: 0;
    color: var(--color-text);
    margin-left: 0;
}

.qty-value {
    width: 72px;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.cta {
    height: 48px;
    border-radius: 12px;
    font-size: 21px;
    -unity-font-style: bold;
    border-width: 0;
    margin-top: 12px;
    margin-left: 0;
}

/* ── 배너 ─────────────────────────────────── */

.banner {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-halt-soft);
    border-radius: 12px;
    padding: 16px;
    margin-top: 16px;
}

.banner-text {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-halt);
}

.notice {
    font-size: 16px;
    color: var(--color-text-weak);
    margin-top: 8px;
    white-space: normal;
}

.hidden {
    display: none;
}

/* ── 호가창 ───────────────────────────────── */

.book-hint {
    font-size: 15px;
    color: var(--color-text-weak);
    white-space: normal;
    margin-top: 4px;
}

.book-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
    border-radius: 6px;
    padding-left: 8px;
    padding-right: 8px;
}

.book-row:hover {
    background-color: var(--color-divider);
}

.book-row--ask {
    background-color: var(--color-rise-soft);
}

.book-row--bid {
    background-color: var(--color-fall-soft);
}

.book-row--mid {
    background-color: var(--color-text);
    height: 40px;
}

.book-price {
    width: 84px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.book-qty {
    flex-grow: 1;
    font-size: 16px;
    color: var(--color-text-weak);
    -unity-text-align: middle-right;
}

.book-mid-price {
    flex-grow: 1;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-panel);
    -unity-text-align: middle-center;
}

/* ── 대기 주문 ────────────────────────────── */

.pending-row {
    flex-direction: row;
    align-items: center;
    height: 40px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-divider);
}

.pending-text {
    flex-grow: 1;
    font-size: 16px;
}

.pending-cancel {
    height: 32px;
    min-width: 48px;
    font-size: 16px;
    border-radius: 8px;
    border-width: 0;
    background-color: var(--color-disabled);
    color: var(--color-text);
    margin-left: 0;
    padding-left: 10px;
    padding-right: 10px;
}

.type-tab {
    flex-grow: 1;
    flex-shrink: 1;
    height: 46px;
    border-radius: 10px;
    font-size: 20px;
    border-width: 0;
    background-color: var(--color-canvas);
    color: var(--color-text-weak);
    margin-right: 8px;
    margin-left: 0;
}

.type-tab.type-tab--on {
    background-color: var(--color-text);
    color: var(--color-panel);
    -unity-font-style: bold;
}

/* ── 정보 기록 팝업 ───────────────────────── */

/* 본문 위에 떠 있다. 자리를 차지하지 않으므로 차트와 호가가 넓게 쓴다.
   손잡이를 눌러 접으면 머리만 남는다. */
.info-popup {
    position: absolute;
    /* 가운데 열 폭에 딱 맞춘다. 접으면 머리 한 줄만 남고,
       그 한 줄 자리는 .col-center가 아래 여백으로 비워 둔다. */
    left: 572px;
    right: 492px;
    bottom: 16px;
    background-color: var(--color-panel);
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--color-divider);
    overflow: hidden;
}

.info-popup-head {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding-left: 16px;
    padding-right: 12px;
}

.info-popup-head:hover {
    background-color: var(--color-canvas);
}

.info-popup-icon {
    font-size: 20px;
    width: 24px;
    color: var(--color-text-weak);
}

.info-popup-body {
    height: 320px;
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
}

.info-popup--collapsed .info-popup-body {
    display: none;
}

/* 접었을 때 머리에 보이는 최근 소식 한 줄. 펼치면 비운다. */
.info-latest {
    font-size: 16px;
    color: var(--color-text-weak);
    margin-left: 16px;
    overflow: hidden;
    -unity-text-align: middle-left;
}

/* ── 수량·지정가 입력칸 ───────────────────── */

/* 숫자를 직접 치는 칸. 증권사 앱과 같게 +/− 는 보조로 남긴다. */
.qty-input {
    width: 86px;
    margin-left: 0;
    margin-right: 0;
}

.qty-input .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: var(--color-text);
}

.qty-unit {
    font-size: 18px;
    color: var(--color-text-weak);
    margin-left: 2px;
}

/* 팔 주식이 없으면 수량칸 자체를 못 쓰게 잠근다. */
.qty-box--off {
    opacity: 0.4;
}

/* ── 차트 가격 눈금 ───────────────────────── */

.chart-axis-label {
    position: absolute;
    font-size: 15px;
    color: var(--color-text-weak);
}

/* 오른쪽 끝의 현재가 꼬리표. 눈금만 있으면 지금 값이 어디인지 바로 안 보인다. */
.chart-price-tag {
    position: absolute;
    font-size: 16px;
    -unity-font-style: bold;
    color: #FFFFFF;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 4px;
}

.chart-price-tag--up {
    background-color: var(--color-rise);
}

.chart-price-tag--down {
    background-color: var(--color-fall);
}

/* ── 보유 요약 ────────────────────────────── */

/* 세 줄로 쌓으면 지정가 줄이 생길 때 주문 열이 넘친다. 가로 세 칸으로 눕힌다. */
.hold-row {
    flex-direction: row;
    flex-shrink: 0;
}

.hold-cell {
    flex-grow: 1;
    flex-basis: 0;
    overflow: hidden;
}

.hold-label {
    font-size: 16px;
    color: var(--color-text-weak);
}

.hold-value {
    font-size: 19px;
    -unity-font-style: bold;
    margin-top: 2px;
}

/* ── 비율 주문 ────────────────────────────── */

/* 금액을 일일이 나눠 치지 않게 한다. 증권사 앱의 10·25·50·최대와 같은 자리다. */
.ratio-btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 34px;
    font-size: 17px;
    margin-left: 0;
    margin-right: 6px;
}

/* 주문 열은 아래로 쌓기만 한다. 대기 주문이 늘어나면 아래 보유 요약을 밀어내므로
   이 목록만 높이를 묶고 안에서 스크롤시킨다. */
#pending-list {
    max-height: 116px;
    overflow: scroll;
}

/* 패널 공통 여백보다 아래를 좁힌다. 주문 열만 담을 것이 많다. */
.col-order {
    padding-bottom: 12px;
}
