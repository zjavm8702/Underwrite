/*
 * 지하거래소 거래 화면 스타일.
 * 토큰 값은 Outputs/MarketUI_v1/Modern_v1/README.md의 설계 규격을 그대로 옮긴 것이다.
 * 수치를 여기서 바꾸면 시안과 어긋나므로, 바꿀 때는 그 문서도 함께 갱신한다.
 */

:root {
    /* ── 색 ───────────────────────────────── */
    --color-canvas: #F5F6F8;
    --color-panel: #FFFFFF;
    --color-text: #202632;
    --color-text-weak: #626C7A;
    --color-divider: #E3E7ED;
    --color-input-border: #7A8493;

    --color-rise: #C53643;
    --color-rise-soft: #FFF0F1;
    --color-fall: #245EC7;
    --color-fall-soft: #EDF3FF;

    --color-private: #6741B0;
    --color-private-soft: #F3EDFF;

    --color-halt: #80510D;
    --color-halt-soft: #FFF4DE;

    --color-disabled: #E3E7ED;

    /* ── 여백 (4px 배수) ──────────────────── */
    --gap-xs: 4px;
    --gap-sm: 8px;
    --gap-md: 12px;
    --gap-lg: 16px;
    --gap-xl: 24px;
    --gap-2xl: 32px;
    --gap-3xl: 48px;
}

/* ── 바탕 ─────────────────────────────────── */

.market-root {
    flex-grow: 1;
    background-color: var(--color-canvas);
    padding-left: 48px;
    padding-right: 48px;
    padding-top: 24px;
    padding-bottom: 64px;
    color: var(--color-text);
}

.panel {
    background-color: var(--color-panel);
    border-radius: 16px;
    padding: 24px;
}

.row {
    flex-direction: row;
}

.grow {
    flex-grow: 1;
}

/* ── 글자 단계 ────────────────────────────── */

.t-title {
    font-size: 28px;
    -unity-font-style: bold;
}

.t-price {
    font-size: 48px;
    -unity-font-style: bold;
}

.t-asset {
    font-size: 30px;
    -unity-font-style: bold;
}

.t-panel {
    font-size: 25px;
    -unity-font-style: bold;
}

.t-body {
    font-size: 20px;
}

.t-body-strong {
    font-size: 20px;
    -unity-font-style: bold;
}

.t-note {
    font-size: 17px;
    color: var(--color-text-weak);
}

.weak {
    color: var(--color-text-weak);
}

/* ── 상단 ─────────────────────────────────── */

.header {
    flex-direction: row;
    align-items: center;
    height: 88px;
}

/* 브랜드 블록이 줄어들면 오른쪽 상태줄과 겹친다. 줄어들지 않게 고정한다.
   Unity USS는 :nth-child를 지원하지 않으므로 클래스로 지정한다. */
.brand {
    flex-shrink: 0;
}

.brand-mark {
    font-size: 16px;
    letter-spacing: 2px;
    color: var(--color-text-weak);
}

.header-status {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: flex-end;
    flex-wrap: wrap;
}

.status-chip {
    font-size: 18px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 8px;
    margin-left: 8px;
}

.status-chip--halt {
    background-color: var(--color-halt-soft);
    color: var(--color-halt);
    -unity-font-style: bold;
}

/* ── 버튼 ─────────────────────────────────── */

.btn {
    height: 56px;
    min-width: 72px;
    border-radius: 12px;
    font-size: 20px;
    border-width: 0;
    background-color: var(--color-disabled);
    color: var(--color-text);
    margin-left: 8px;
    padding-left: 16px;
    padding-right: 16px;
}

.btn:hover {
    opacity: 0.85;
}

.btn--small {
    height: 44px;
    min-width: 48px;
    font-size: 16px;
    padding-left: 10px;
    padding-right: 10px;
    margin-left: 6px;
    flex-shrink: 1;
}

.btn.btn--selected {
    background-color: var(--color-text);
    color: var(--color-panel);
    -unity-font-style: bold;
}

.btn--buy {
    background-color: var(--color-rise);
    color: var(--color-panel);
    -unity-font-style: bold;
}

.btn--sell {
    background-color: var(--color-fall);
    color: var(--color-panel);
    -unity-font-style: bold;
}

.btn--disabled {
    background-color: var(--color-disabled);
    color: var(--color-text-weak);
}

.tab {
    flex-grow: 1;
    height: 56px;
    border-radius: 12px;
    font-size: 20px;
    border-width: 0;
    background-color: var(--color-canvas);
    color: var(--color-text-weak);
    margin-right: 8px;
}

.tab--buy-on {
    background-color: var(--color-rise-soft);
    color: var(--color-rise);
    -unity-font-style: bold;
}

.tab--sell-on {
    background-color: var(--color-fall-soft);
    color: var(--color-fall);
    -unity-font-style: bold;
}

/* ── 자산 줄 ──────────────────────────────── */

.asset-row {
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
    padding: 10px 28px 10px 28px;
    background-color: var(--color-panel);
    border-radius: 16px;
}

/* 장부 한 줄의 칸. 칸마다 바탕을 깔지 않고 가는 잉크 줄로만 나눈다. */
.asset-card {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 4px 24px 4px 24px;
    border-right-width: 1px;
    border-right-color: var(--color-divider);
}

.asset-card--main {
    flex-grow: 1.4;
}

.asset-card--last {
    border-right-width: 0;
}

.t-asset--main {
    font-size: 40px;
}

/* ── 본문 3열 ─────────────────────────────── */

.body {
    flex-direction: row;
    flex-grow: 1;
    margin-top: 24px;
}

/* 고정폭을 쓰지 않는다. Game 뷰 크기와 PanelSettings의 ScaleWithScreenSize 때문에
   논리 폭이 1920이 아닐 수 있다. 실제로 872x1160 창에서는 1142px로 해석된다.
   기준 폭을 flex-basis로 주고 최소폭까지 줄어들게 해 좁은 화면에서도 3열을 유지한다. */
.col-stocks {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: 500px;
    min-width: 300px;
    margin-right: 24px;
}

.col-center {
    padding-bottom: 72px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 320px;
    margin-right: 24px;
}

.col-order {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: 420px;
    min-width: 300px;
}

/* ── 종목 행 ──────────────────────────────── */

.stock-row {
    height: 120px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-divider);
    justify-content: center;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 12px;
}

.stock-row--selected {
    background-color: var(--color-canvas);
}

.stock-line {
    flex-direction: row;
    align-items: center;
}

.stock-name {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    font-size: 20px;
    -unity-font-style: bold;
}

.stock-price {
    font-size: 20px;
    -unity-font-style: bold;
    min-width: 80px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.stock-change {
    font-size: 20px;
    -unity-font-style: bold;
    min-width: 110px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.rise {
    color: var(--color-rise);
}

.fall {
    color: var(--color-fall);
}

.flat {
    color: var(--color-text-weak);
}

/* ── 차트 ─────────────────────────────────── */

.chart {
    flex-grow: 1;
    min-height: 200px;
    margin-top: 28px;
    margin-bottom: 20px;
}

/* 저·시작·고를 차트 위 제자리에 찍는다. 아래에 나란히 적으면 어느 지점인지 알 수 없다.
   위치가 매 틱 바뀌므로 절대 배치로 좌표를 코드에서 준다. */
.chart-marker-label {
    position: absolute;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.78);
    border-radius: 6px;
    padding: 0 6px 0 6px;
}

.chart-marker-label--high {
    color: var(--color-rise);
}

.chart-marker-label--low {
    color: var(--color-fall);
}

.chart-marker-label--open {
    color: var(--color-text-weak);
}

/* ── 정보 카드 ────────────────────────────── */

.info-card {
    flex-shrink: 0;
    border-radius: 10px;
    padding: 10px 14px 10px 14px;
    margin-bottom: 8px;
    background-color: var(--color-canvas);
    border-left-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
}

.info-card--private {
    background-color: var(--color-private-soft);
}

/* 가진 종목의 소식. 왼쪽 띠로 먼저 눈에 띄게 한다. */
.info-card--held {
    border-left-color: rgb(158, 52, 40);
}

.info-line {
    flex-direction: row;
    align-items: center;
}

.info-stock {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--color-text);
    flex-shrink: 0;
}

.info-held {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(247, 240, 226);
    background-color: rgb(158, 52, 40);
    border-radius: 8px;
    padding: 1px 8px 1px 8px;
    margin-left: 8px;
    flex-shrink: 0;
}

.info-when {
    flex-grow: 1;
    min-width: 0;
    font-size: 14px;
    color: var(--color-text-weak);
    -unity-text-align: middle-right;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-left: 8px;
}

.info-dot {
    width: 9px;
    height: 9px;
    border-radius: 5px;
    margin-left: 8px;
    flex-shrink: 0;
}

.info-dot--public {
    background-color: var(--color-text-weak);
}

.info-dot--private {
    background-color: var(--color-private);
}

.info-secret {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--color-private);
    margin-left: 4px;
    flex-shrink: 0;
}

.info-headline {
    font-size: 18px;
    white-space: normal;
    margin-top: 4px;
    color: var(--color-text);
}

/* ── 주문 ─────────────────────────────────── */

.order-line {
    flex-direction: row;
    align-items: center;
    height: 32px;
    flex-shrink: 0;
    margin-bottom: 2px;
}

/* 주문 패널은 위에서 아래로 쌓인다. 어느 요소도 겹치지 않게 모두 줄어들지 않게 둔다. */
.col-order > * {
    flex-shrink: 0;
}

.order-label {
    flex-grow: 1;
    font-size: 20px;
    color: var(--color-text-weak);
}

.order-value {
    font-size: 20px;
    -unity-font-style: bold;
}

.qty-box {
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: var(--color-input-border);
    border-radius: 12px;
    height: 46px;
    flex-shrink: 0;
}

.qty-step {
    width: 44px;
    height: 46px;
    font-size: 24px;
    background-color: transparent;
    border-width: 0;
    color: var(--color-text);
    margin-left: 0;
}

.qty-value {
    width: 72px;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.cta {
    height: 48px;
    border-radius: 12px;
    font-size: 21px;
    -unity-font-style: bold;
    border-width: 0;
    margin-top: 12px;
    margin-left: 0;
}

/* ── 배너 ─────────────────────────────────── */

.banner {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-halt-soft);
    border-radius: 12px;
    padding: 16px;
    margin-top: 16px;
}

.banner-text {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-halt);
}

.notice {
    font-size: 16px;
    color: var(--color-text-weak);
    margin-top: 8px;
    white-space: normal;
}

.hidden {
    display: none;
}

/* ── 호가창 ───────────────────────────────── */

.book-hint {
    font-size: 15px;
    color: var(--color-text-weak);
    white-space: normal;
    margin-top: 4px;
}

.book-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
    border-radius: 6px;
    padding-left: 8px;
    padding-right: 8px;
}

.book-row:hover {
    background-color: var(--color-divider);
}

.book-row--ask {
    background-color: var(--color-rise-soft);
}

.book-row--bid {
    background-color: var(--color-fall-soft);
}

.book-row--mid {
    background-color: var(--color-text);
    height: 40px;
}

.book-price {
    width: 84px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.book-qty {
    flex-grow: 1;
    font-size: 16px;
    color: var(--color-text-weak);
    -unity-text-align: middle-right;
}

.book-mid-price {
    flex-grow: 1;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-panel);
    -unity-text-align: middle-center;
}

/* ── 대기 주문 ────────────────────────────── */

.pending-row {
    flex-direction: row;
    align-items: center;
    height: 40px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-divider);
}

.pending-text {
    flex-grow: 1;
    font-size: 16px;
}

.pending-cancel {
    height: 32px;
    min-width: 48px;
    font-size: 16px;
    border-radius: 8px;
    border-width: 0;
    background-color: var(--color-disabled);
    color: var(--color-text);
    margin-left: 0;
    padding-left: 10px;
    padding-right: 10px;
}

.type-tab {
    flex-grow: 1;
    flex-shrink: 1;
    height: 46px;
    border-radius: 10px;
    font-size: 20px;
    border-width: 0;
    background-color: var(--color-canvas);
    color: var(--color-text-weak);
    margin-right: 8px;
    margin-left: 0;
}

.type-tab.type-tab--on {
    background-color: var(--color-text);
    color: var(--color-panel);
    -unity-font-style: bold;
}

/* ── 정보 기록 팝업 ───────────────────────── */

/* 본문 위에 떠 있다. 자리를 차지하지 않으므로 차트와 호가가 넓게 쓴다.
   손잡이를 눌러 접으면 머리만 남는다. */
/* 가운데 열 폭에 딱 맞춘 하단 바. 띠 두 개가 나란히 선다.
   접으면 머리 한 줄만 남고, 그 한 줄 자리는 .col-center가 아래 여백으로 비워 둔다.
   flex-end로 맞춰 두면 펼친 띠만 위로 자란다. */
.bottom-bar {
    position: absolute;
    left: 572px;
    right: 492px;
    bottom: 16px;
    flex-direction: row;
    align-items: flex-end;
}

.info-popup {
    flex-grow: 1;
    flex-shrink: 1;
    background-color: var(--color-panel);
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--color-divider);
    overflow: hidden;
}

/* 보유는 종목 수가 적어 폭이 덜 필요하다. 소식 쪽에 넓은 자리를 준다.
   왼쪽에 둔다. 오른쪽에 두면 펼쳤을 때 호가창을 덮는데, 보유 목록은 팔기 직전에 보는 것이라
   그때 호가가 가려지면 곤란하다. 소식은 읽는 동안 거래가 멈추므로 오른쪽이라도 괜찮다. */
.holdings-popup {
    width: 360px;
    flex-shrink: 0;
    margin-right: 16px;
    background-color: var(--color-panel);
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--color-divider);
    overflow: hidden;
}

.holdings-popup--collapsed .info-popup-body {
    display: none;
}

.holdings-profit {
    font-size: 19px;
    -unity-font-style: bold;
}

/* ── 보유 행 ──────────────────────────────── */

.holding-row {
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 8px;
    flex-shrink: 0;
}

.holding-row:hover {
    background-color: var(--color-canvas);
}

.holding-line {
    flex-direction: row;
    align-items: center;
}

.holding-name {
    flex-grow: 1;
    font-size: 18px;
    -unity-font-style: bold;
}

.holding-qty {
    font-size: 17px;
    -unity-font-style: bold;
}

.holding-sub {
    flex-grow: 1;
    font-size: 15px;
    color: var(--color-text-weak);
}

.holding-profit {
    font-size: 16px;
    -unity-font-style: bold;
}

.info-popup-head {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding-left: 16px;
    padding-right: 12px;
}

.info-popup-head:hover {
    background-color: var(--color-canvas);
}

.info-popup-icon {
    font-size: 20px;
    width: 24px;
    color: var(--color-text-weak);
}

.info-popup-body {
    height: 420px;
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
}

.info-popup--collapsed .info-popup-body {
    display: none;
}

/* 접었을 때 머리에 보이는 최근 소식 한 줄. 펼치면 비운다. */
.info-latest {
    /* 글자 길이만큼 자리를 요구하면 띠 밖으로 밀려 잘린다.
       flex-basis를 0으로 두어 남는 자리만 쓰게 하고, 넘치면 말줄임표로 끊는다. */
    min-width: 0;
    flex-basis: 0;
    flex-shrink: 1;
    font-size: 16px;
    color: var(--color-text-weak);
    margin-left: 16px;
    margin-right: 12px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

/* ── 수량·지정가 입력칸 ───────────────────── */

/* 숫자를 직접 치는 칸. 증권사 앱과 같게 +/− 는 보조로 남긴다. */
.qty-input {
    width: 86px;
    margin-left: 0;
    margin-right: 0;
}

.qty-input .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: var(--color-text);
}

.qty-unit {
    font-size: 18px;
    color: var(--color-text-weak);
    margin-left: 2px;
}

/* 팔 주식이 없으면 수량칸 자체를 못 쓰게 잠근다. */
.qty-box--off {
    opacity: 0.4;
}

/* ── 차트 가격 눈금 ───────────────────────── */

.chart-axis-label {
    position: absolute;
    font-size: 16px;
    /* 2026-10-18 교차 검수: 옅어서 읽기 어렵다(Codex). 흐린 글자보다 한 단계 짙게. */
    color: #3E3326;
}

/* 오른쪽 끝의 현재가 꼬리표. 눈금만 있으면 지금 값이 어디인지 바로 안 보인다. */
.chart-price-tag {
    position: absolute;
    font-size: 16px;
    -unity-font-style: bold;
    color: #FFFFFF;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 4px;
}

.chart-price-tag--up {
    background-color: var(--color-rise);
}

.chart-price-tag--down {
    background-color: var(--color-fall);
}

/* ── 보유 요약 ────────────────────────────── */

/* 세 줄로 쌓으면 지정가 줄이 생길 때 주문 열이 넘친다. 가로 세 칸으로 눕힌다. */
.hold-row {
    flex-direction: row;
    flex-shrink: 0;
}

.hold-cell {
    flex-grow: 1;
    flex-basis: 0;
    overflow: hidden;
}

.hold-label {
    font-size: 16px;
    color: var(--color-text-weak);
}

.hold-value {
    font-size: 19px;
    -unity-font-style: bold;
    margin-top: 2px;
}

/* ── 비율 주문 ────────────────────────────── */

/* 금액을 일일이 나눠 치지 않게 한다. 증권사 앱의 10·25·50·최대와 같은 자리다. */
.ratio-btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 34px;
    font-size: 17px;
    margin-left: 0;
    margin-right: 6px;
}

/* 패널 공통 여백보다 아래를 좁힌다. 주문 열만 담을 것이 많다. */
.col-order {
    padding-bottom: 12px;
}

/* ── 대기 주문 ────────────────────────────── */

/* 주문 패널에는 자리가 없다. 종목 목록 아래 남는 자리가 넓고 폭도 여유롭다.
   남는 높이를 이 칸이 전부 가져가고, 넘치면 안에서 스크롤한다. */
.pending-box {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

.pending-head {
    flex-shrink: 0;
}

.pending-divider {
    height: 1px;
    background-color: var(--color-divider);
    margin-top: 12px;
    margin-bottom: 12px;
}

.pending-scroll {
    flex-grow: 1;
    min-height: 0;
}

/* ── 일중 요약 ────────────────────────────── */

/* 호가 아래 남는 자리. 시가는 고정이고 고·저는 갱신될 때마다 바뀐다. */
.day-stats {
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: var(--color-divider);
    padding-top: 10px;
    margin-top: 10px;
}

.day-line {
    flex-direction: row;
    align-items: center;
    height: 28px;
}

.day-label {
    flex-grow: 1;
    font-size: 16px;
    color: var(--color-text-weak);
}

.day-value {
    font-size: 17px;
    -unity-font-style: bold;
}

/* 보유 목록은 종목 수가 적다. 소식만큼 높일 이유가 없다. */
.holdings-popup .info-popup-body {
    height: 240px;
}

/* ── 주문 결과 쪽지 ───────────────────────── */

/* 체결은 한순간이라 주문 패널 아래 작은 글자로는 놓친다.
   눈이 가 있는 자리(주문 패널 위쪽)에 잠깐 띄우고 스스로 사라지게 한다. */
.toast-area {
    position: absolute;
    right: 48px;
    top: 150px;
    width: 420px;
    align-items: flex-end;
}

.toast {
    flex-shrink: 0;
    margin-bottom: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--color-divider);
    background-color: var(--color-panel);
    max-width: 420px;
}

.toast-text {
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
}

.toast-note {
    font-size: 15px;
    color: var(--color-text-weak);
    white-space: normal;
    margin-top: 2px;
}

/* 매수는 붉게, 매도는 푸르게, 막힌 주문은 잉크로. 색만 봐도 무슨 일인지 안다. */
.toast--buy {
    border-color: var(--color-rise);
    background-color: var(--color-rise-soft);
}

.toast--sell {
    border-color: var(--color-fall);
    background-color: var(--color-fall-soft);
}

.toast--deny {
    border-color: var(--color-text-weak);
}

/* 떠나기로 공고된 종목. 설계안 §5의 사전 확인을 행에 적는다. */
.stock-notice {
    font-size: 15px;
    color: var(--color-halt);
    -unity-font-style: bold;
    margin-top: 2px;
}

/* ── 주문 결과 쪽지 ───────────────────────── */

/* 체결은 한순간이라 주문 패널 아래 작은 글자로는 놓친다.
   눈이 가 있는 자리(주문 패널 위쪽)에 잠깐 띄우고 스스로 사라지게 한다. */
.toast-area {
    position: absolute;
    right: 48px;
    top: 150px;
    width: 420px;
    align-items: flex-end;
}

.toast {
    flex-shrink: 0;
    margin-bottom: 8px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--color-divider);
    background-color: var(--color-panel);
    max-width: 420px;
}

.toast-text {
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
}

.toast-note {
    font-size: 15px;
    color: var(--color-text-weak);
    white-space: normal;
    margin-top: 2px;
}

/* 매수는 붉게, 매도는 푸르게, 막힌 주문은 잉크로. 색만 봐도 무슨 일인지 안다. */
.toast--buy {
    border-color: var(--color-rise);
    background-color: var(--color-rise-soft);
}

.toast--sell {
    border-color: var(--color-fall);
    background-color: var(--color-fall-soft);
}

.toast--deny {
    border-color: var(--color-text-weak);
}

/* 떠나기로 공고된 종목. 설계안 §5의 사전 확인을 행에 적는다. */
.stock-notice {
    font-size: 15px;
    color: var(--color-halt);
    -unity-font-style: bold;
    margin-top: 2px;
}

/* ── 정보 타임 연출 ───────────────────────── */

/* 거래 화면을 통째로 덮는다. 정보 타임은 알림이 아니라 하나의 사건이다.
   기획서 §11: 주식 패널을 내리고 지하세계 장면을 보여 준 뒤 돌아온다. */
.scene {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/UI/Images/underworld_room.png");
    -unity-background-scale-mode: scale-and-crop;
    background-color: #140F0A;
}

/* 분위기가 나쁠 때는 등불이 꺼져 가는 판을 쓴다. 같은 방이고 빛만 다르다. */
.scene--dim {
    background-image: url("project://database/Assets/UI/Images/underworld_room_dim.png");
}

/* 정보원이 설 자리. 인물 그림이 들어오기 전까지는 비워 둔다. */
.scene-figure {
    position: absolute;
    left: 300px;
    top: 150px;
    width: 600px;
    bottom: 300px;
    -unity-background-scale-mode: scale-to-fit;
}

/* 글자 상자는 화면 아래 1/3에 깔린다. 배경이 그 자리를 비워 두고 있다. */
.scene-box {
    position: absolute;
    left: 110px;
    right: 110px;
    bottom: 48px;
    background-color: var(--color-panel);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--color-divider);
    padding-top: 22px;
    padding-bottom: 20px;
    padding-left: 32px;
    padding-right: 32px;
}

.scene-when {
    font-size: 17px;
    color: var(--color-text-weak);
}

.scene-source {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-text-weak);
    margin-top: 6px;
}

.scene-line {
    font-size: 27px;
    -unity-font-style: bold;
    color: var(--color-text);
    white-space: normal;
    margin-top: 8px;
    min-height: 76px;
}

.scene-hint {
    font-size: 16px;
    color: var(--color-text-weak);
}

.scene-next {
    width: 160px;
    margin-top: 0;
    background-color: var(--color-text);
    color: var(--color-panel);
}

/* 나만 아는 정보는 색으로 구분한다. 시장이 아직 모르는 이야기다. */
.scene-source--private {
    color: var(--color-private);
}

/* ── 아이콘 ───────────────────────────────── */

/* 유니코드 글자로 찍던 기호를 손으로 그은 그림으로 바꾼다.
   흰 단색 그림이므로 tint로 색을 입힌다. */
.icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.icon--rise {
    background-image: url("project://database/Assets/UI/Images/icon_rise.png");
    -unity-background-image-tint-color: var(--color-rise);
}

.icon--fall {
    background-image: url("project://database/Assets/UI/Images/icon_fall.png");
    -unity-background-image-tint-color: var(--color-fall);
}

.icon--flat {
    background-image: url("project://database/Assets/UI/Images/icon_flat.png");
    -unity-background-image-tint-color: var(--color-text-weak);
}

.icon--expand {
    background-image: url("project://database/Assets/UI/Images/icon_expand.png");
    -unity-background-image-tint-color: var(--color-text-weak);
}

.icon--collapse {
    background-image: url("project://database/Assets/UI/Images/icon_collapse.png");
    -unity-background-image-tint-color: var(--color-text-weak);
}

.icon--warning {
    background-image: url("project://database/Assets/UI/Images/icon_warning.png");
    -unity-background-image-tint-color: var(--color-halt);
    width: 18px;
    height: 18px;
}

/* ── 즐겨찾기 ─────────────────────────────── */

/* 상장이 늘면 목록이 길어진다. 눈여겨보는 종목을 위로 올린다. */
.star {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    margin-right: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    background-image: url("project://database/Assets/UI/Images/icon_star_off.png");
    -unity-background-image-tint-color: var(--color-divider);
    -unity-background-scale-mode: scale-to-fit;
    padding: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.star--on {
    background-image: url("project://database/Assets/UI/Images/icon_star_on.png");
    -unity-background-image-tint-color: var(--color-halt);
}

/* 예고 줄의 경고 표식과 글자를 한 줄에 둔다. */
.notice-line {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

/* ── 공용 팝업 ────────────────────────────── */

/* 확인이 필요한 일에만 쓴다. 흘려보내도 되는 소식은 쪽지가 맡는다. */
.popup-veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(20, 15, 10, 0.62);
    align-items: center;
    justify-content: center;
}

.popup {
    width: 620px;
    background-color: var(--color-panel);
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--color-divider);
    padding-top: 28px;
    padding-bottom: 24px;
    padding-left: 32px;
    padding-right: 32px;
}

.popup-tag {
    font-size: 17px;
    color: var(--color-text-weak);
    -unity-font-style: bold;
}

.popup-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-top: 4px;
    white-space: normal;
}

.popup-body {
    font-size: 19px;
    color: var(--color-text);
    white-space: normal;
    margin-top: 12px;
}

.popup-button {
    width: 150px;
    height: 48px;
    margin-top: 0;
    margin-left: 10px;
}

.popup-button--main {
    background-color: var(--color-text);
    color: var(--color-panel);
}

/* ── 영지 화면 ────────────────────────────── */

.village-root {
    flex-grow: 1;
}

/* 오늘 더 돌아볼 수 있는 횟수. 시간이 자원이라는 것을 늘 보여 둔다. */
.village-visits {
    position: absolute;
    top: 24px;
    right: 32px;
    font-size: 19px;
    -unity-font-style: bold;
    /* 밝은 돌바닥 위에서도 읽히게 짙은 띠를 깐다(2026-10-17 사용자 보고: 잘 안 보인다). */
    color: #F2E7D2;
    background-color: rgba(42, 33, 24, 0.82);
    border-radius: 12px;
    padding: 10px 18px 10px 18px;
}

/* 자리에 다가섰을 때만 뜬다. 화면 아래 가운데가 눈이 가장 먼저 가는 자리다. */
.village-prompt {
    position: absolute;
    bottom: 56px;
    left: 50%;
    translate: -50% 0;
    min-width: 420px;
    background-color: var(--color-panel);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--color-divider);
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 28px;
    padding-right: 28px;
    align-items: center;
}

.village-place {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--color-text);
}

.village-cost {
    font-size: 17px;
    color: var(--color-text-weak);
    margin-top: 2px;
}

.village-key {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-halt);
    margin-top: 8px;
}

/* ── 공용 대화상자 ────────────────────────── */

/* 왼쪽에 인물 상반신, 오른쪽에 말. 비주얼 노벨의 기본 배치다.
   전신을 다 보여 주면 얼굴이 작아져 표정이 안 읽힌다. */
.dialogue-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #140F0A;
    -unity-background-scale-mode: scale-and-crop;
}

.dialogue-root--underworld {
    background-image: url("project://database/Assets/UI/Images/underworld_room.png");
}

.dialogue-root--underworld-dim {
    background-image: url("project://database/Assets/UI/Images/underworld_room_dim.png");
}

.dialogue-root--tavern {
    background-image: url("project://database/Assets/UI/Images/place_tavern.png");
}

.dialogue-root--guild {
    background-image: url("project://database/Assets/UI/Images/place_guild.png");
}

.dialogue-root--board {
    background-image: url("project://database/Assets/UI/Images/place_board.png");
}

/* 대장간과 영주관은 아직 그림이 없다. 가장 가까운 것을 빌려 쓴다.
   place_smith.png / place_manor.png가 들어오면 이 두 줄만 바꾼다. */
/* 온보딩 장면 일러스트(Outputs/OnboardingScenes_v1, 2026-10-18). 다락방 아침 · 용사단을 알아보는 순간. */
.dialogue-root--attic {
    background-image: url("project://database/Assets/UI/Images/scene_attic_morning.png");
}

.dialogue-root--heroes {
    background-image: url("project://database/Assets/UI/Images/scene_heroes_recognized.png");
}

/* 거리에 선 혼잣말. 그림 없이 영지가 비쳐 보이게 옅게만 가린다(2026-10-18 프롤로그). */
.dialogue-root--street {
    background-color: rgba(20, 15, 10, 0.35);
}

.dialogue-root--smith {
    background-image: url("project://database/Assets/UI/Images/place_tavern.png");
}

.dialogue-root--manor {
    background-image: url("project://database/Assets/UI/Images/place_guild.png");
}

.dialogue-stage {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding-left: 60px;
    padding-right: 60px;
    padding-top: 48px;
    padding-bottom: 48px;
}

/* 상반신 그림을 통째로 둔다. 전신을 잘라 쓰지 않는다.
   표정이 바뀌는 그림이 따로 들어오므로 잘라 맞추면 표정이 어긋난다. */
.dialogue-figure-frame {
    width: 620px;
    height: 820px;
    flex-shrink: 0;
    align-self: flex-end;
}

.dialogue-figure {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.dialogue-box {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 420px;
    /* 선택지가 넷이면 560px를 넘는다. 잘리면 마지막 선택지(그냥 간다)를 못 누른다. */
    max-height: 900px;
    margin-left: 48px;
    background-color: var(--color-panel);
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--color-divider);
    padding-top: 28px;
    padding-bottom: 24px;
    padding-left: 36px;
    padding-right: 36px;
}

.dialogue-speaker {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--color-text);
}

.dialogue-tag {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-text-weak);
    margin-top: 4px;
}

/* 시장이 아직 모르는 이야기는 색으로 가른다. */
.dialogue-tag--secret {
    color: var(--color-private);
}

.dialogue-text {
    font-size: 27px;
    -unity-font-style: bold;
    color: var(--color-text);
    white-space: normal;
    margin-top: 18px;
}

.dialogue-note {
    font-size: 16px;
    color: var(--color-text-weak);
    white-space: normal;
}

.dialogue-next {
    width: 160px;
    margin-top: 0;
    margin-left: 12px;
    background-color: var(--color-text);
    color: var(--color-panel);
}

/* 선택지. 말 상자 아래에 세로로 쌓는다.
   번호를 앞에 붙여 키보드 숫자로도 고를 수 있게 한다. */
.dialogue-choices {
    margin-top: 12px;
    max-height: 480px;
    flex-shrink: 1;
}

.dialogue-choice {
    flex-direction: column;
    align-items: flex-start;
    margin-left: 0;
    margin-right: 0;
    margin-top: 8px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 20px;
    padding-right: 20px;
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--color-divider);
    background-color: var(--color-panel);
}

.dialogue-choice:hover {
    border-color: var(--color-text);
}

.dialogue-choice-text {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text);
    white-space: normal;
}

.dialogue-choice-note {
    font-size: 15px;
    color: var(--color-text-weak);
    white-space: normal;
    margin-top: 2px;
}

/* 고를 수 없는 것도 숨기지 않는다. 흐리게 두고 이유를 적는다. */
.dialogue-choice--locked {
    opacity: 0.45;
}

.dialogue-choice--locked:hover {
    border-color: var(--color-divider);
}

/* ── 영지 메뉴 (2026-10-17) ─────────────────
   단추는 「메뉴」 하나. 누르면 그 위로 목록이 펼쳐진다(드롭업). 항목은 코드가 채운다. */
.village-menu {
    position: absolute;
    right: 36px;
    bottom: 36px;
    width: 180px;
    height: 52px;
    margin: 0;
    font-size: 20px;
    -unity-font-style: bold;
}

.village-menu-list {
    position: absolute;
    right: 36px;
    bottom: 96px;
    width: 260px;
}

.village-menu-item {
    min-height: 52px;
    margin: 0 0 6px 0;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* 원형 시계. 화면 가운데에 띄우고 뒤는 어둡게 깐다. */
.village-clock {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(10, 8, 6, 0.55);
    align-items: center;
    justify-content: center;
}

.village-clock-panel {
    width: 520px;
    padding: 32px 40px 28px 40px;
    align-items: center;
}

.village-clock-dial {
    width: 320px;
    height: 320px;
    margin-top: 12px;
    margin-bottom: 12px;
}

.time-dial-hour {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #2A2118;
}

.village-clock-pick {
    font-size: 26px;
    -unity-font-style: bold;
    color: #2A2118;
}

.village-clock-skip {
    margin-top: 10px;
    font-size: 18px;
    color: #2A2118;
}

.village-clock-skip .unity-toggle__text {
    color: #2A2118;
    margin-left: 6px;
}

.village-clock-buttons {
    margin-top: 18px;
}

.village-clock-buttons > Button {
    width: 180px;
    height: 48px;
    margin: 0 8px;
}

/* ── 눌림 연출 ────────────────────────────────
   2026-10-17 사용자 요청. 누르는 순간 살짝 줄었다가 돌아온다.
   :active는 누르고 있는 동안만 켜진다. 그림 교체는 테마 파일(.Parchment)이 맡는다. */
.btn,
.cta,
.ratio-btn,
.tab,
.type-tab,
.popup-button,
.dialogue-next,
.dialogue-choice,
.village-button {
    transition-property: scale, opacity;
    transition-duration: 0.08s, 0.08s;
    transition-timing-function: ease-out, ease-out;
}

.btn:active,
.cta:active,
.ratio-btn:active,
.tab:active,
.type-tab:active,
.popup-button:active,
.dialogue-next:active,
.dialogue-choice:active,
.village-button:active {
    scale: 0.96 0.96;
}

/* 잠긴 것은 눌려도 반응하지 않는다. 눌리는 척하면 고를 수 있는 줄 안다. */
.btn--disabled:active,
.dialogue-choice--locked:active {
    scale: 1 1;
}

/* ── 필드 말풍선 (WorldBubbles) ───────────── */
.world-bubble {
    position: absolute;
    max-width: 320px;
    padding: 6px 12px 6px 12px;
    border-radius: 12px;
    background-color: rgba(247, 240, 226, 0.95);
    border-width: 1px;
    border-color: rgb(91, 77, 62);
    color: #2A2118;
    font-size: 17px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* 감정 표시는 크고 둥글게. 글자 하나다. */
.world-bubble--emote {
    font-size: 26px;
    -unity-font-style: bold;
    padding: 0 10px 2px 10px;
    border-radius: 18px;
    color: rgb(158, 52, 40);
}

/* ── 튜토리얼 (UI_Tutorial) ───────────────── */
.tutorial-shade {
    background-color: rgba(12, 9, 6, 0.68);
}

.tutorial-frame {
    border-width: 3px;
    border-color: rgb(242, 196, 107);
    border-radius: 14px;
}

.tutorial-card {
    background-color: #F2E7D2;
    border-width: 2px;
    border-color: rgb(91, 77, 62);
    border-radius: 14px;
    padding: 18px 22px 16px 22px;
}

.tutorial-count {
    font-size: 14px;
    color: #5B4D3E;
}

.tutorial-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #2A2118;
    margin-top: 2px;
}

.tutorial-body {
    font-size: 18px;
    color: #2A2118;
    white-space: normal;
    margin-top: 8px;
}

.tutorial-buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 14px;
}

.tutorial-buttons > Button {
    width: 120px;
    margin-left: 8px;
}

/* ── 시간 넘기기 연출 ─────────────────────── */
.village-fade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(10, 8, 6);
    align-items: center;
    justify-content: center;
}

.village-fade-time {
    font-size: 44px;
    -unity-font-style: bold;
    color: #F2E7D2;
}

.village-fade-note {
    font-size: 20px;
    color: #C9BBA2;
    margin-top: 8px;
}

/* ── 모험단 도감 줄 ───────────────────────── */
.codex-fact {
    font-size: 16px;
    color: var(--color-text);
    white-space: normal;
    margin-top: 4px;
}

.codex-fact--unknown {
    color: var(--color-text-weak);
    -unity-font-style: italic;
}

/* ── 영지 수첩 ───────────────────────────── */
.notebook {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(10, 8, 6, 0.55);
    align-items: center;
    justify-content: center;
}

.notebook-panel {
    width: 760px;
    height: 820px;
    padding: 30px 36px 24px 36px;
}

.notebook-tabs {
    flex-direction: row;
    margin-top: 10px;
    margin-bottom: 10px;
}

.notebook-tabs > Button {
    width: 140px;
    margin-right: 8px;
}

.notebook-list {
    flex-grow: 1;
}

/* 영지 「할 일」. 이야기가 시작되기 전까지만 보인다. */
.village-objective {
    position: absolute;
    top: 24px;
    left: 32px;
    padding: 10px 18px 10px 18px;
    border-radius: 12px;
    background-color: rgba(42, 33, 24, 0.82);
    color: #F2C46B;
    font-size: 19px;
    -unity-font-style: bold;
}

/* 대화 이름 옆 배지 — 내 보유 종목 */
.dialogue-badge {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(247, 240, 226);
    background-color: rgb(158, 52, 40);
    border-radius: 10px;
    padding: 3px 12px 3px 12px;
    margin-left: 10px;
    align-self: center;
}

/* ── 장부 맞추기 (길드 기록실) ───────────────
   길드 기록실 배경 위에 양피지 두 장. 숫자를 읽는 칸이라 장식은 테두리(양피지 틀)에만 둔다. */
.ledger {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-image: url("project://database/Assets/UI/Images/place_guild.png");
    -unity-background-scale-mode: scale-and-crop;
    padding: 28px 48px 28px 48px;
}

.ledger-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.ledger-title {
    font-size: 30px;
    -unity-font-style: bold;
    color: #F2C46B;
    padding: 8px 20px 8px 20px;
    border-radius: 12px;
    background-color: rgba(30, 22, 15, 0.82);
}

.ledger-suspicion {
    font-size: 20px;
    color: #F7F0E2;
    padding: 8px 18px 8px 18px;
    border-radius: 12px;
    background-color: rgba(122, 34, 28, 0.85);
}

.ledger-hint {
    margin-top: 12px;
    font-size: 19px;
    color: #F7F0E2;
    white-space: normal;
    padding: 8px 18px 8px 18px;
    border-radius: 10px;
    background-color: rgba(30, 22, 15, 0.7);
    align-self: flex-start;
}

.ledger-pages {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    margin-top: 16px;
    margin-bottom: 12px;
}

.ledger-page {
    width: 46%;
    margin-left: 14px;
    margin-right: 14px;
    padding: 30px 36px 30px 36px;
}

.ledger-head {
    font-size: 16px;
    color: var(--color-text-weak);
    margin-top: 6px;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-divider);
}

.ledger-list {
    flex-grow: 1;
}

.ledger-row {
    font-size: 20px;
    color: var(--color-text);
    white-space: normal;
    -unity-text-align: middle-left;
    margin: 0 0 4px 0;
    padding: 8px 12px 8px 12px;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(201, 187, 162, 0.6);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.ledger-row {
    flex-direction: row;
    align-items: center;
}

.ledger-cell {
    font-size: 20px;
    color: var(--color-text);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.ledger-cell--grow {
    flex-grow: 1;
    flex-shrink: 1;
}

.ledger-cell--day {
    width: 76px;
    color: var(--color-text-weak);
}

/* 숫자는 오른쪽 끝을 맞춘다. 더해 보는 퍼즐이다. */
.ledger-cell--amount {
    width: 80px;
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

.ledger-cell--note {
    width: 72px;
    margin-left: 18px;
    color: var(--color-text-weak);
}

.ledger-row--pick:hover {
    background-color: rgba(242, 196, 107, 0.35);
}

.ledger-row--wrong {
    background-color: rgba(181, 50, 62, 0.18);
    color: var(--color-text-weak);
}

.ledger-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.ledger-message {
    font-size: 19px;
    color: #F7F0E2;
    flex-grow: 1;
    white-space: normal;
}

.ledger-leave {
    width: 200px;
    height: 56px;
    font-size: 20px;
}

/* 첫 지하 방문 튜토리얼의 지금 할 일 띠. 화면 위 가운데에 늘 떠 있다. */
.market-coach {
    position: absolute;
    top: 86px;
    left: 18%;
    right: 18%;
    padding: 12px 28px 12px 28px;
    font-size: 22px;
    -unity-font-style: bold;
    color: #2B2118;
    white-space: normal;
    -unity-text-align: middle-center;
    border-radius: 12px;
    border-width: 3px;
    border-color: #B88A2E;
    background-color: rgba(247, 230, 190, 0.96);
}

/* ── 영지 미니맵 (2026-10-18) ───────────────
   오른쪽 위 시계 아래에 작게(지도 비율 16:9), 펼치면 화면 가운데에 크게. 바닥은 영지 바닥 그림. */
.minimap {
    position: absolute;
    top: 76px;
    right: 32px;
    width: 336px;
    height: 216px;
    padding: 6px;
    border-radius: 12px;
    border-width: 3px;
    border-color: #8C6238;
    background-color: rgba(42, 33, 24, 0.9);
}

.minimap--expanded {
    top: 90px;
    right: 8%;
    width: 84%;
    height: 82%;
}

.minimap-map {
    flex-grow: 1;
    border-radius: 8px;
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
}

.minimap-hint {
    position: absolute;
    bottom: 8px;
    right: 12px;
    font-size: 13px;
    color: #F2E7D2;
    padding: 2px 8px 2px 8px;
    border-radius: 6px;
    background-color: rgba(20, 15, 10, 0.75);
}

.minimap--expanded .minimap-hint {
    font-size: 18px;
}

/* 표지 한 개: 점 + 이름. 자리는 점의 가운데. */
.minimap-marker {
    position: absolute;
    align-items: center;
    translate: -50% -8px;
}

.minimap-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    border-width: 2px;
    border-color: #2B2118;
}

.minimap-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: #F2E7D2;
    padding: 0 4px 0 4px;
    margin-top: 1px;
    border-radius: 4px;
    background-color: rgba(20, 15, 10, 0.78);
    white-space: nowrap;
}

/* 장소 이름은 점 위, 사람 이름은 점 아래 — 붙어 있어도 겹치지 않게. */
.minimap-place {
    flex-direction: column-reverse;
    translate: -50% -100%;
}

.minimap-place .minimap-dot {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background-color: #F2C46B;
}

.minimap-person .minimap-dot {
    background-color: #7FB3D5;
}

/* 작은 지도에서는 사람 이름을 감춘다 — 장소 이름만으로도 빽빽하다. */
.minimap-person .minimap-label {
    display: none;
}

.minimap--expanded .minimap-person .minimap-label {
    display: flex;
    font-size: 14px;
}

.minimap--expanded .minimap-place .minimap-label {
    font-size: 18px;
}

.minimap-place--target .minimap-dot {
    background-color: #E8603C;
    width: 18px;
    height: 18px;
}

.minimap-place--target .minimap-label {
    color: #FFD98A;
}

.minimap-player {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    translate: -50% -50%;
    background-color: #FF4A4A;
    border-width: 3px;
    border-color: #FFFFFF;
}

/* ── 장면 전환 제목 카드 (2026-10-18) ───────────────
   화면이 어두워지며 큰 글씨. 밝기는 코드가 매 프레임 opacity로 정한다. */
.title-card {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: #0E0A07;
    justify-content: center;
    align-items: center;
}

.title-card-title {
    font-size: 64px;
    -unity-font-style: bold;
    color: #F2E7D2;
    letter-spacing: 8px;
}

.title-card-sub {
    margin-top: 18px;
    font-size: 24px;
    color: rgba(242, 231, 210, 0.7);
}

/* ── 미니게임 규칙서 (2026-10-18) ───────────────
   장소 배경 위에 큰 종이 한 장. 가운데 무대에서 실제 게임 부품이 움직인다. */
.rulebook {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    justify-content: center;
    align-items: center;
}

.rulebook-page {
    width: 1180px;
    height: 820px;
    padding: 36px 56px 30px 56px;
    align-items: center;
}

.rulebook-heading {
    font-size: 18px;
    color: var(--color-text-weak);
}

.rulebook-title {
    margin-top: 6px;
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--color-text);
}

.rulebook-stage {
    flex-grow: 1;
    width: 100%;
    margin-top: 18px;
    margin-bottom: 14px;
    justify-content: center;
    align-items: center;
    border-radius: 14px;
    background-color: rgba(90, 70, 50, 0.08);
}

.rulebook-set {
    align-items: center;
    justify-content: center;
}

.rulebook-body {
    font-size: 22px;
    color: var(--color-text);
    white-space: normal;
    -unity-text-align: middle-center;
    min-height: 70px;
    max-width: 960px;
}

.rulebook-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 12px;
}

.rulebook-button {
    width: 200px;
    height: 56px;
    font-size: 21px;
}

.rulebook-count {
    font-size: 18px;
    color: var(--color-text-weak);
}

.rule-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: 8px 0 8px 0;
}

.rule-who {
    width: 70px;
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-text-weak);
}

.rule-die {
    transition-property: background-color, border-color, scale;
    transition-duration: 0.2s;
}

/* 보이지 않지만 이렇게 있다 - 상대 주사위를 옅게. */
.rule-die--ghost {
    opacity: 0.55;
    border-color: #A89276;
}

.rule-row--rolling .rule-die {
    scale: 0.9 0.9;
}

.rule-bubble {
    margin: 6px 0 6px 0;
    padding: 10px 22px 10px 22px;
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--color-text);
    border-radius: 16px;
    background-color: #FFFDF6;
    border-width: 2px;
    border-color: #A89276;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}

.rule-bubble--no {
    color: #9A2B33;
    border-color: #C9898F;
}

.rule-caption {
    margin-top: 10px;
    font-size: 24px;
    -unity-font-style: bold;
    color: #9A2B33;
    min-height: 34px;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.rule-stamp {
    position: absolute;
    right: 18px;
    top: 10px;
    padding: 4px 16px 4px 16px;
    font-size: 34px;
    -unity-font-style: bold;
    color: #B5323E;
    border-width: 4px;
    border-color: #B5323E;
    border-radius: 8px;
    rotate: -12deg;
    transition-property: opacity, scale;
    transition-duration: 0.18s;
}

.rule-stamp--inline {
    position: relative;
    right: auto;
    top: auto;
    margin: 4px 0 4px 0;
    font-size: 28px;
}

.rule-hidden {
    opacity: 0;
    scale: 1.3 1.3;
}

.rule-bubble.rule-hidden {
    scale: 1 1;
    translate: 0 10px;
}

.rule-token {
    margin: 0 10px 0 10px;
    padding: 10px 22px 10px 22px;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text);
    border-radius: 10px;
    border-width: 2px;
    border-color: #A89276;
    background-color: #F7F0E2;
    transition-property: background-color, opacity;
    transition-duration: 0.25s;
}

.rule-token--won {
    background-color: #F2C46B;
    border-color: #B88A2E;
}

.rule-token--unused {
    opacity: 0.3;
}

.rule-slip {
    width: 300px;
    min-height: 150px;
    margin: 0 14px 0 14px;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.rule-slip--big {
    width: 460px;
}

/* 실전 카드(.smith-slip: 폭 30%)보다 우선 — 규칙서 무대에서는 고정 폭. */
.smith-slip.rule-slip {
    width: 300px;
}

.smith-slip.rule-slip--big {
    width: 460px;
}

.rule-struck {
    opacity: 0.25;
}

.rule-glow {
    background-color: rgba(242, 196, 107, 0.55);
    border-radius: 6px;
}

.rule-clue {
    width: 760px;
    transition-property: opacity, translate;
    transition-duration: 0.3s;
}

.rule-cell {
    transition-property: scale;
    transition-duration: 0.12s;
}

.rule-pressed {
    scale: 0.92 0.92;
}

.rule-grid-head {
    width: 130px;
    font-size: 19px;
    -unity-font-style: bold;
    color: var(--color-text-weak);
    -unity-text-align: middle-center;
}

.rule-grid-cell {
    width: 130px;
    height: 54px;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #2B2118;
    background-color: #F7F0E2;
    border-width: 2px;
    border-color: #A89276;
    border-radius: 8px;
    margin: 0 4px 0 4px;
}

.rule-grid-cell--no {
    color: #B5323E;
}

.rule-grid-cell--yes {
    color: #2E6B3A;
    background-color: #E6F0D8;
}

/* ── 기록 짜맞추기 (길드) ───────────────
   왼쪽은 쪽지 더미, 오른쪽은 채우는 표. 표는 숫자·이름 칸이라 깨끗하게. */
.deduce {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    padding: 28px 48px 28px 48px;
}

.deduce-body {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    margin-top: 16px;
    margin-bottom: 12px;
}

.deduce-clues {
    width: 640px;
    margin-right: 24px;
}

.deduce-clue-list {
    margin-top: 10px;
}

.deduce-clue {
    width: auto;
    margin: 6px 0 6px 0;
    padding: 18px 26px 18px 26px;
    font-size: 21px;
    color: var(--color-text);
    white-space: normal;
}

.deduce-table {
    width: 720px;
    padding: 30px 36px 30px 36px;
}

.deduce-row {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.deduce-band {
    width: 200px;
    font-size: 21px;
    -unity-font-style: bold;
    color: var(--color-text);
    white-space: normal;
}

.deduce-head {
    width: 220px;
    margin: 0 8px 0 8px;
    font-size: 18px;
    color: var(--color-text-weak);
    -unity-text-align: middle-center;
}

.deduce-pick {
    width: 220px;
    height: 56px;
    -unity-text-align: middle-center;
    margin: 0 8px 0 8px;
    font-size: 20px;
    color: #2B2118;
    background-color: #F7F0E2;
    border-width: 2px;
    border-color: #A89276;
    border-radius: 10px;
}

.deduce-options {
    margin-top: 18px;
    padding-top: 12px;
    font-size: 18px;
    color: var(--color-text-weak);
    white-space: normal;
    border-top-width: 1px;
    border-top-color: var(--color-divider);
}

.deduce-pick--blank {
    color: var(--color-text-weak);
    border-color: #D8C9B0;
}

/* ── 주사위 내기 (여관) ───────────────
   배경은 대화 배경 클래스(dialogue-root--tavern)를 함께 붙인다. 가운데 종이 한 장이 술상이다. */
.dice {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    padding: 28px 48px 28px 48px;
}

/* .popup의 고정 폭(620px)을 풀어 화면 가운데 넓게 편다. */
.dice-table {
    flex-grow: 1;
    width: 1100px;
    align-self: center;
    margin: 16px 0 12px 0;
    padding: 36px 48px 36px 48px;
    align-items: center;
    justify-content: space-around;
}

.dice-mood {
    font-size: 20px;
    color: var(--color-text-weak);
    -unity-font-style: italic;
}

.dice-row {
    flex-direction: row;
    justify-content: center;
}

/* 주사위 한 알. 숫자 칸이라 장식 없이 크고 또렷하게. */
.dice-die {
    width: 72px;
    height: 72px;
    margin: 0 8px 0 8px;
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #2B2118;
    background-color: #F7F0E2;
    border-width: 3px;
    border-color: #5A4632;
    border-radius: 12px;
}

.dice-die--hidden {
    color: #F7F0E2;
    background-color: #5A4632;
}

.dice-die--match {
    border-color: #B5323E;
    background-color: #FBE3C4;
}

.dice-bid {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin: 8px 0 8px 0;
}

/* 두 줄: 위는 개수·눈, 아래는 부른다·거짓말. */
/* 연습 판의 코치 · 실전의 판단 재료. 말 상자와 구분되게 옅은 띠. */
.dice-coach {
    font-size: 19px;
    color: #5A4632;
    white-space: normal;
    -unity-text-align: middle-center;
    padding: 8px 16px 8px 16px;
    border-radius: 8px;
    background-color: rgba(242, 196, 107, 0.28);
    max-width: 900px;
}

.dice-controls {
    align-items: center;
}

.dice-pick,
.dice-actions {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
}

.dice-count {
    flex-direction: row;
    align-items: center;
    margin-right: 18px;
}

.dice-step {
    width: 52px;
    height: 52px;
    font-size: 26px;
}

.dice-count-label {
    width: 72px;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-text);
}

.dice-faces {
    flex-direction: row;
    margin-right: 18px;
}

.dice-face-button {
    width: 52px;
    height: 52px;
    margin: 0 3px 0 3px;
    font-size: 24px;
    -unity-font-style: bold;
    color: #2B2118;
    background-color: #F7F0E2;
    border-width: 2px;
    border-color: #A89276;
    border-radius: 10px;
}

.dice-face-button--on {
    border-color: #B5323E;
    border-width: 3px;
    background-color: #FBE3C4;
}

.dice-action {
    width: 180px;
    height: 56px;
    margin: 0 8px 0 8px;
    font-size: 21px;
}

.dice-next {
    width: 240px;
    height: 56px;
    font-size: 21px;
}

/* ── 주문서 읽기 (대장간) ───────────────
   배경은 대화 배경 클래스(dialogue-root--smith)를 함께 붙인다. 주문서는 종이 틀 카드, 3장씩 두 줄. */
.smith-orders {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    padding: 28px 48px 28px 48px;
}

.smith-rumor {
    margin-top: 14px;
    font-size: 24px;
    -unity-font-style: bold;
    color: #F2C46B;
    white-space: normal;
    padding: 10px 20px 10px 20px;
    border-radius: 10px;
    background-color: rgba(30, 22, 15, 0.85);
    align-self: flex-start;
}

.smith-rack {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-content: center;
    margin-top: 12px;
    margin-bottom: 12px;
}

.smith-slip {
    width: 30%;
    min-height: 170px;
    margin: 14px 12px 14px 12px;
    padding: 26px 30px 26px 30px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    border-radius: 0;
}

.smith-slip:hover {
    -unity-background-image-tint-color: rgb(255, 236, 196);
}

.smith-slip--wrong {
    opacity: 0.5;
}

.smith-slip-top {
    flex-direction: row;
    justify-content: space-between;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-divider);
}

.smith-slip-day {
    font-size: 18px;
    color: var(--color-text-weak);
}

.smith-slip-status {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-text);
}

/* 취소된 주문서는 도장처럼 붉게. 미끼를 가려내는 단서라 눈에 띄어야 한다. */
.smith-slip-status--cancelled {
    color: #B5323E;
}

.smith-slip-band {
    margin-top: 10px;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text);
    white-space: normal;
}

.smith-slip-item {
    margin-top: 8px;
    font-size: 21px;
    color: var(--color-text);
    white-space: normal;
}

/* ── 주문 나르기 (여관·대장간·길드의 일) ───────
   배경은 대화 배경 클래스(dialogue-root--*)를 함께 붙여 일하는 곳의 그림을 쓴다. */
.work {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
    justify-content: center;
}

.work-panel {
    width: 980px;
    min-height: 560px;
    padding: 34px 44px 30px 44px;
}

.work-head {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-top: 6px;
    margin-bottom: 14px;
}

.work-body {
    flex-grow: 1;
}

.work-tickets {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 18px;
}

/* 주문표 한 장. 숫자 칸이므로 장식 없이 깨끗하게. */
.work-ticket {
    width: 270px;
    min-height: 120px;
    margin: 8px;
    padding: 14px 16px 14px 16px;
    font-size: 21px;
    color: var(--color-text);
    white-space: normal;
    background-color: rgba(255, 252, 244, 0.85);
    border-width: 1px;
    border-color: var(--color-divider);
    border-radius: 6px;
}

.work-shelf {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.work-item {
    width: 150px;
    height: 64px;
    margin: 6px;
    font-size: 21px;
}

.work-tray {
    margin-top: 18px;
    margin-bottom: 12px;
    padding: 14px 18px 14px 18px;
    font-size: 21px;
    color: var(--color-text);
    white-space: normal;
    background-color: rgba(255, 252, 244, 0.85);
    border-width: 1px;
    border-color: var(--color-divider);
    border-radius: 6px;
}

.work-actions {
    flex-direction: row;
    justify-content: center;
}

.work-button {
    width: 200px;
    height: 56px;
    margin: 6px;
    font-size: 20px;
    align-self: center;
}

.work-message {
    font-size: 19px;
    color: var(--color-text-weak);
    margin-top: 8px;
    min-height: 28px;
    white-space: normal;
}

.work-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
}

.work-hint {
    font-size: 16px;
    color: var(--color-text-weak);
}

/* ── 여관 엿듣기 ─────────────────────────── */
.eaves-panel {
    width: 1180px;
    padding: 34px 44px 30px 44px;
}

.eaves-tables {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
    margin-bottom: 14px;
}

/* 테이블 한 자리. 글을 읽는 칸이라 장식 없이 깨끗하게. */
.eaves-table {
    width: 250px;
    min-height: 220px;
    margin: 8px;
    padding: 14px 16px 14px 16px;
    background-color: rgba(255, 252, 244, 0.85);
    border-width: 1px;
    border-color: var(--color-divider);
    border-radius: 6px;
    justify-content: space-between;
}

.eaves-table-name {
    font-size: 21px;
    -unity-font-style: bold;
    color: var(--color-text);
    white-space: normal;
}

.eaves-table-mood {
    font-size: 17px;
    color: var(--color-text-weak);
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 6px;
}

.eaves-listen {
    height: 50px;
    font-size: 18px;
}

.eaves-log {
    height: 170px;
    padding: 10px 14px 10px 14px;
    background-color: rgba(255, 252, 244, 0.6);
    border-width: 1px;
    border-color: var(--color-divider);
    border-radius: 6px;
    margin-bottom: 10px;
}

.eaves-line {
    font-size: 18px;
    color: var(--color-text);
    white-space: normal;
    margin-bottom: 6px;
}

/* 거래 종목 아래 — 다음 계절 상장 예정인 단. 거래할 수 없으니 흐리게, 그러나 눈에 띄게. */
.arrivals-head {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--color-text-weak);
    margin-top: 18px;
    margin-bottom: 6px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: var(--color-divider);
}

.arrival-row {
    font-size: 17px;
    color: var(--color-text-weak);
    padding: 4px 8px 4px 8px;
}

/* 지하 방 칠판의 분필 글씨. 칠판 그림의 글자 칸에 맞춰 코드가 자리를 잡는다. */
.chalk-board {
    position: absolute;
}

/* 칠판 격자 한 줄에 한 종목. */
.chalk-row {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
}

.chalk-cell {
    font-size: 16px;
    color: rgba(236, 236, 226, 0.88);
    -unity-font-style: bold;
    padding: 0 6px 0 6px;
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
}

.chalk-cell--name {
    width: 60%;
    -unity-text-align: middle-left;
}

.chalk-cell--price,
.chalk-cell--change {
    width: 20%;
    -unity-text-align: middle-right;
}

.chalk-row--up .chalk-cell {
    color: rgba(255, 176, 170, 0.92);
}

.chalk-row--down .chalk-cell {
    color: rgba(176, 206, 255, 0.92);
}
