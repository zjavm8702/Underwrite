/*
 * 지하거래소 — 양피지 테마.
 *
 * 색 토큰과 패널 배경 이미지만 덮어쓴다. 구조·간격·폰트는 MarketScreen.uss 그대로다.
 * 이미지: Outputs/MarketUI_Parchment_v1 (Codex 제작). 9-slice Border는 패널 48px, 선택 24px.
 *
 * 가독성이 최우선이다. 질감 때문에 숫자가 안 읽히면 실패다.
 * 글자가 놓이는 자리는 거의 단색이어야 하므로 질감의 명암 대비를 낮게 유지한다.
 */

:root {
    /* 바탕과 면 — 이미지가 덮으므로 색은 보조 역할이다. */
    --color-canvas: #2A1F17;
    --color-panel: #F2E7D2;
    --color-divider: #C9BBA2;
    --color-input-border: #8A7A62;
    --color-disabled: #DCCDB4;

    /* 글자 — 양피지 위의 잉크 */
    --color-text: #2A2118;
    --color-text-weak: #5B4D3E;

    /* 상승·하락. 양피지 위에서도 구별되도록 채도를 유지한다. */
    --color-rise: #B5323E;
    --color-rise-soft: #F6E0DC;
    --color-fall: #1F56B8;
    --color-fall-soft: #DEE7F7;

    /* 나만 아는 정보 */
    --color-private: #5B3BA3;
    --color-private-soft: #E8E0F5;

    /* 휴장 */
    --color-halt: #7A4A0C;
    --color-halt-soft: #F6E6C8;
}

/* 상단 줄도 양피지 띠 위에 올린다.
   밝은 글자로 나무 바탕에 직접 쓰면 버튼의 옅은 면과 테두리가 묻혀 보이지 않는다.
   띠를 깔면 패널 안과 같은 잉크색을 그대로 쓸 수 있다. */
.header {
    background-image: url("project://database/Assets/UI/Images/market_panel.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.5;
    height: 96px;
    padding-left: 24px;
    padding-right: 16px;
}

/* 화면 바탕 — 지하실의 어두운 나무 탁자 */
.market-root {
    background-image: url("project://database/Assets/UI/Images/market_background.png");
    -unity-background-scale-mode: scale-and-crop;
    background-color: #2A1F17;
}

/* 패널 — 양피지. 9-slice로 늘어난다. */
.panel,
.asset-card,
.info-popup,
.holdings-popup {
    background-image: url("project://database/Assets/UI/Images/market_panel.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.5;
    border-width: 0;
}

/* 선택된 종목 행 — 톤이 다른 양피지 */
.stock-row--selected {
    background-image: url("project://database/Assets/UI/Images/market_selection.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 24;
    -unity-slice-right: 24;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
    -unity-slice-scale: 0.5;
}

/* 조작 부품도 종이다. 색만 칠한 사각형은 양피지 세계와 겉돈다.
   9-slice는 48px이지만 scale 0.25로 그린다. 0.5면 테두리가 상하 24+24=48px이 되어
   높이 34~46px인 작은 버튼에서 중앙이 사라지고 테두리끼리 맞닿는다. */
.btn,
.btn--small,
.ratio-btn,
.tab,
.type-tab,
.pending-cancel {
    background-image: url("project://database/Assets/UI/Images/ui_button_normal.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.25;
    border-width: 0;
    color: var(--color-text);
}

/* 선택 상태는 잉크로 칠한 면이다. 글자는 종이색으로 뒤집어야 읽힌다.
   같은 명시도끼리는 뒤에 오는 규칙이 이기므로 .btn 지정보다 뒤에 둔다. */
.btn.btn--selected,
.type-tab.type-tab--on {
    background-image: url("project://database/Assets/UI/Images/ui_button_pressed.png");
    background-color: rgba(0, 0, 0, 0);
    color: #F7F0E2;
    border-width: 0;
    -unity-font-style: bold;
}

/* 탭은 앞으로 나온 종이와 뒤로 물러난 종이로 나뉜다. */
.tab {
    background-image: url("project://database/Assets/UI/Images/ui_tab_off.png");
}

.tab.tab--buy-on,
.tab.tab--sell-on {
    background-image: url("project://database/Assets/UI/Images/ui_tab_on.png");
    -unity-font-style: bold;
}

/* 고른 쪽이 무엇인지 한눈에 보여야 한다. 글자색만 바꾸면 약하다.
   종이에 tint를 입혀 면 자체를 물들인다. 질감은 그대로 남고 색만 바뀐다. */
.tab.tab--buy-on {
    -unity-background-image-tint-color: var(--color-rise);
    color: #FBF3E6;
}

.tab.tab--sell-on {
    -unity-background-image-tint-color: var(--color-fall);
    color: #FBF3E6;
}

/* 고르지 않은 쪽은 한 걸음 물러난다. */
.tab {
    color: var(--color-text-weak);
}

/* 못 쓰는 단추는 바랜 종이다. */
.btn--disabled,
.btn.btn--disabled {
    background-image: url("project://database/Assets/UI/Images/ui_button_disabled.png");
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text-weak);
    border-width: 0;
}

.btn--buy {
    background-color: var(--color-rise);
    color: #F7EFE2;
    border-color: var(--color-rise);
}

.btn--sell {
    background-color: var(--color-fall);
    color: #F7EFE2;
    border-color: var(--color-fall);
}

.btn--disabled {
    background-color: rgba(42, 33, 24, 0.06);
    color: var(--color-text-weak);
    border-color: rgba(42, 33, 24, 0.14);
}

/* 호가창 — 양피지 위에서 띠가 과하지 않게 */
.book-row--mid {
    background-color: var(--color-text);
}

.book-mid-price {
    color: #F2E7D2;
}

/* 수량·지정가 입력칸. 눌린 것이 아니라 홈이 파여 숫자를 적는 자리다. */
.qty-box {
    background-image: url("project://database/Assets/UI/Images/ui_field.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.25;
    border-width: 0;
}

/* 정보 카드는 --color-canvas를 쓰는데, 양피지에서는 그게 어두운 나무색이라 검게 나온다.
   패널보다 살짝 어두운 종이색으로 따로 지정한다. */
.info-card {
    background-color: rgba(42, 33, 24, 0.07);
}

.info-card--private {
    background-color: var(--color-private-soft);
}


/* 팝업 머리를 누를 때의 강조도 어두운 나무색이 아니라 종이색으로. */
.info-popup-head:hover {
    background-color: rgba(42, 33, 24, 0.06);
}

/* 호가창 띠가 양피지 위에서 과하지 않게 톤을 낮춘다. */
.book-row--ask {
    background-color: rgba(181, 50, 62, 0.10);
}

.book-row--bid {
    background-color: rgba(31, 86, 184, 0.10);
}

.book-row:hover {
    background-color: rgba(42, 33, 24, 0.10);
}

/* 차트 마커 라벨 - 흰 알약은 양피지 위에서 뜬다. 종이색으로 맞춘다. */
.chart-marker-label {
    background-color: rgba(242, 231, 210, 0.85);
}

/* 입력칸 바탕 — 양피지 위에서는 종이보다 살짝 밝게 파인 자리로 둔다. */
.qty-input .unity-base-text-field__input {
    color: #2A2118;
}

/* 쪽지도 같은 종이다. 9-slice까지 쓰면 작은 쪽지에서 테두리가 뭉개지므로 색만 맞춘다. */
.toast {
    background-color: #F2E7D2;
    border-color: #C9BBA2;
}

/* 연출 글자 상자도 같은 종이다. */
.scene-box {
    background-image: url("project://database/Assets/UI/Images/market_panel.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.5;
    border-width: 0;
}

.scene-next {
    background-image: url("project://database/Assets/UI/Images/ui_button_pressed.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.25;
    color: #F7F0E2;
    border-width: 0;
}

/* 공용 팝업도 같은 종이다. */
.popup {
    background-image: url("project://database/Assets/UI/Images/market_panel.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.5;
    border-width: 0;
}

.popup-button {
    background-image: url("project://database/Assets/UI/Images/ui_button_normal.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.25;
    color: var(--color-text);
    border-width: 0;
}

.popup-button--main {
    background-image: url("project://database/Assets/UI/Images/ui_button_pressed.png");
    color: #F7F0E2;
}
