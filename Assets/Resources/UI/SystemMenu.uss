/* 설정 창(2026-10-19). 어느 장면에서든 같은 모양 — 양피지 창(popup_panel)과 영지 단추. UI_SystemMenu가 자기 화면층에 붙인다. */

.system-veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(8, 6, 4, 0.62);
    align-items: center;
    justify-content: center;
}

.system-panel {
    width: 600px;
    padding: 44px 56px 40px 56px;
    background-image: url("project://database/Assets/UI/Images/popup_panel.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 64;
    -unity-slice-bottom: 64;
    -unity-slice-scale: 0.5px;
    border-width: 0;
}

.system-title {
    font-size: 30px;
    color: rgb(59, 42, 26);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.system-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 6px;
}

.system-label {
    width: 110px;
    font-size: 20px;
    color: rgb(59, 42, 26);
}

.system-slider {
    flex-grow: 1;
    margin-left: 0;
    margin-right: 12px;
}

.system-value {
    width: 64px;
    font-size: 18px;
    color: rgb(90, 70, 48);
    -unity-text-align: middle-right;
}

.system-note {
    font-size: 14px;
    color: rgb(106, 84, 64);
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 6px;
}

.system-buttons {
    margin-top: 14px;
}

.system-button {
    height: 54px;
    margin-top: 8px;
    font-size: 20px;
    color: rgb(247, 240, 226);
    background-image: url("project://database/Assets/UI/Images/village_button_normal.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
    -unity-slice-scale: 0.25px;
    border-width: 0;
}

.system-button:active {
    background-image: url("project://database/Assets/UI/Images/village_button_pressed.png");
}
