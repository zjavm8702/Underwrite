; Underwrite 코드 작업 규칙 — Documents/Underwrite_코드_작업규칙.md v1.0
; 이 파일은 문서의 서식 항목만 강제한다. 문서가 상위다.

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,asmdef,md,yml,yaml}]
indent_size = 2
; 마크다운은 줄 끝 두 칸이 줄바꿈이므로 공백을 지우지 않는다
[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4
max_line_length = 120

# ─────────────────────────────────────────────
# §12 using 정렬 — 그룹 분리 없이 단일 알파벳 순
# ─────────────────────────────────────────────
dotnet_sort_system_directives_first = false
dotnet_separate_import_directive_groups = false
dotnet_style_namespace_match_folder = true:suggestion

# ─────────────────────────────────────────────
# §5 중괄호와 분기
# ─────────────────────────────────────────────
# 모든 분기에 중괄호 필수
csharp_prefer_braces = true:warning

# switch 식과 분기용 식 본문 멤버 금지
csharp_style_prefer_switch_expression = false:warning
csharp_style_expression_bodied_methods = false:warning
csharp_style_expression_bodied_local_functions = false:warning
csharp_style_expression_bodied_operators = false:warning
csharp_style_expression_bodied_lambdas = true:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_constructors = false:silent

# 패턴 매칭으로 되돌리는 제안을 끈다 (§6의 == true/== false 유지)
csharp_style_prefer_pattern_matching = false:silent
csharp_style_prefer_not_pattern = false:silent

# ─────────────────────────────────────────────
# §6 Allman 중괄호
# ─────────────────────────────────────────────
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current

csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_parentheses = false

csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# ─────────────────────────────────────────────
# §8 접근 수정자 명시
# ─────────────────────────────────────────────
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:suggestion
dotnet_style_readonly_field = true:suggestion

# ─────────────────────────────────────────────
# §3 이름 규칙
# ─────────────────────────────────────────────

# const 필드 → UPPER_SNAKE_CASE
dotnet_naming_rule.const_fields_upper_snake.severity = suggestion
dotnet_naming_rule.const_fields_upper_snake.symbols = const_fields
dotnet_naming_rule.const_fields_upper_snake.style = upper_snake_case
dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.applicable_accessibilities = *
dotnet_naming_symbols.const_fields.required_modifiers = const

# static readonly 필드 → UPPER_SNAKE_CASE
dotnet_naming_rule.static_readonly_fields_upper_snake.severity = suggestion
dotnet_naming_rule.static_readonly_fields_upper_snake.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_upper_snake.style = upper_snake_case
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

# private·protected 인스턴스 필드 → PascalCase, 밑줄 없음
dotnet_naming_rule.private_fields_pascal.severity = suggestion
dotnet_naming_rule.private_fields_pascal.symbols = private_fields
dotnet_naming_rule.private_fields_pascal.style = pascal_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, protected, protected_internal, private_protected

# 타입·메서드·프로퍼티·이벤트 → PascalCase
dotnet_naming_rule.members_pascal.severity = warning
dotnet_naming_rule.members_pascal.symbols = type_and_members
dotnet_naming_rule.members_pascal.style = pascal_case
dotnet_naming_symbols.type_and_members.applicable_kinds = class, struct, enum, interface, delegate, method, property, event
dotnet_naming_symbols.type_and_members.applicable_accessibilities = *

# 인터페이스 → I 접두사 (§2)
dotnet_naming_rule.interfaces_prefixed.severity = warning
dotnet_naming_rule.interfaces_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_prefixed.style = i_prefix_pascal
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

# 지역변수·매개변수 → camelCase
dotnet_naming_rule.locals_camel.severity = suggestion
dotnet_naming_rule.locals_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_camel.style = camel_case
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.upper_snake_case.capitalization = all_upper
dotnet_naming_style.upper_snake_case.word_separator = _
dotnet_naming_style.i_prefix_pascal.capitalization = pascal_case
dotnet_naming_style.i_prefix_pascal.required_prefix = I

# ─────────────────────────────────────────────
# 그 밖의 제안
# ─────────────────────────────────────────────
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent
dotnet_style_qualification_for_field = false:silent
dotnet_style_qualification_for_property = false:silent
dotnet_style_qualification_for_method = false:silent
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = block_scoped:warning
dotnet_diagnostic.IDE0005.severity = suggestion

# ─────────────────────────────────────────────
# 패키지 소스에는 프로젝트 규칙을 적용하지 않는다
# ─────────────────────────────────────────────
[Library/PackageCache/**/*.cs]
dotnet_analyzer_diagnostic.severity = none
csharp_prefer_braces = true:silent
csharp_style_prefer_switch_expression = true:silent
csharp_style_expression_bodied_methods = true:silent
dotnet_style_require_accessibility_modifiers = never:silent
