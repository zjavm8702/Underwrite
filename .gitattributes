*.jpeg  binary
*.gif   binary
*.psd   binary
*.psb   binary
*.tga   binary
*.tif   binary
*.bmp   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.mp4   binary
*.zip   binary
*.dll   binary
*.so    binary
*.a     binary
*.pdf   binary
